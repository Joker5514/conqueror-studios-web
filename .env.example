# ─── Supabase (browser) ────────────────────────────────────────────────────────
# Supabase project URL — used by both the browser client and as a fallback on
# the server when SUPABASE_URL is not set.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon key — safe to expose to the browser (subject to RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Supabase (server-side overrides) ─────────────────────────────────────────
# These override the NEXT_PUBLIC_* vars on the server to avoid the browser
# service proxy URL. Optional but strongly recommended in production.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service-role key — server-only, bypasses RLS, NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Postmark ──────────────────────────────────────────────────────────────────
# Server API token from Postmark → Servers → <your server> → API Tokens
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Verified sender address in Postmark (must be a verified domain or email).
# conquerorstudios.dev had no public DNS on 2026-10-27. Use a sender Postmark
# has actually verified. Do not use this host as the public site URL.
POSTMARK_FROM_EMAIL=no-reply@conquerorstudios.dev

# Message stream IDs (default: "outbound" and "broadcasts").
# POSTMARK_MESSAGE_STREAM=outbound
# POSTMARK_BROADCAST_MESSAGE_STREAM=broadcasts

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Stripe secret key from the Stripe dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (from `stripe listen --print-secret` or dashboard).
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Site URL ──────────────────────────────────────────────────────────────────
# Canonical public URL used for generating absolute links (unsubscribe, billing).
# Production: https://www.conqueror-studios.com
# Local:      http://localhost:3000
# conquerorstudios.dev does not resolve and is rewritten to the www host.
NEXT_PUBLIC_SITE_URL=https://www.conqueror-studios.com

# Random server-only secret used to sign per-recipient unsubscribe links.
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_TOKEN_SECRET=replace-with-a-long-random-secret

# ─── Backend Services (server-only) ────────────────────────────────────────────
# URL of the OrchestrAI Nexus service. Server-only — never exposed to the browser.
# Production: https://nexus-production.up.railway.app
# Local dev:  http://localhost:8000
NEXUS_URL=http://localhost:8000

# URL of the AI Bridge service. Server-only — never exposed to the browser.
# This is AI Bridge v2 (GET /tools/schema), not the Drive/GitHub ai-bridge repo.
# Production: https://ai-bridge-production.up.railway.app
# Local dev:  http://localhost:8001
BRIDGE_URL=http://localhost:8001

# Optional shared secrets sent server-side only. Leave unset until the upstream
# service validates them. They are never exposed to the browser.
# NEXUS_SHARED_SECRET=
# BRIDGE_SHARED_SECRET=

# ─── Console access control (required) ────────────────────────────────────────
# Comma-separated owner emails. Required. An empty value fails closed:
# /console and the admin APIs return 503 until this is set.
CONSOLE_OWNER_EMAILS=r.jordan@conqueror-studios.com

# ─── Sandbox / Local dev (GIC environment — do not set in production) ──────────
# Override the server Supabase URL directly (highest priority).
# GIC_SERVER_SUPABASE_URL=http://127.0.0.1:54321

# JSON array of local services injected by the GIC sandbox runner.
# GIC_BROWSER_LOCAL_SERVICES_JSON=[{"alias":"supabase","port":54321,"scheme":"http"}]
