# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase project URL (used on both client and server)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service-role key (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Postmark ─────────────────────────────────────────────────────────────────
# Server API token from Postmark → Servers → <your server> → API Tokens
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Verified sender address in Postmark
POSTMARK_FROM_EMAIL=no-reply@conquerorstudios.dev

# Message stream IDs (default: "outbound" and "broadcasts")
# POSTMARK_MESSAGE_STREAM=outbound
# POSTMARK_BROADCAST_MESSAGE_STREAM=broadcasts

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Stripe secret key from the Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (from `stripe listen --print-secret` or dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Backend Services (Phase 1) ───────────────────────────────────────────────
# URL of the OrchestrAI Nexus service (server-only, never exposed to browser)
# Production: https://nexus-production.up.railway.app
# Local dev:  http://localhost:8000
NEXUS_URL=http://localhost:8000

# URL of the AI Bridge service (server-only, never exposed to browser)
# Production: https://ai-bridge-production.up.railway.app
# Local dev:  http://localhost:8001
BRIDGE_URL=http://localhost:8001
